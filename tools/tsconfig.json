// The program of the tools: every file of `tools/` but `golden.ts`, with the
// Bun types. The files of the packages that a tool imports are checked here
// too, with those types. `golden.ts` stays out: it imports the old code in
// `ref/`, which the project keeps out of the type check.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["."],
  "exclude": ["golden.ts"]
}
