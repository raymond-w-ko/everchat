// The guard of the core: a second program over the core's files only, with
// no Bun and no Node types, and a `lib` of what Bun, Node and `workerd` share.
// `tsc` follows imports, so a listed file passes only if all that it imports
// passes too. A core file that passes goes in `files`.
// `tsconfig.core.d.ts` declares, for this program only, what the core may use
// beyond `ESNext`: `createHash` of `node:crypto`, `TextEncoder`, `TextDecoder`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": []
  },
  "include": [],
  "files": [
    "tsconfig.core.d.ts",
    "src/ask.ts",
    "src/cache.ts",
    "src/compactor.ts",
    "src/diagnostics.ts",
    "src/follow.ts",
    "src/functions.ts",
    "src/head.ts",
    "src/limit.ts",
    "src/memory.ts",
    "src/pace.ts",
    "src/pages.ts",
    "src/prompt.ts",
    "src/request.ts",
    "src/sandbox.ts",
    "src/store.ts",
    "src/turn.ts"
  ]
}
